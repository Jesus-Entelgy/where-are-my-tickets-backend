{
  "name": "where-are-my-tickets-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file=.env.development ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file=.env.development ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:team": "node --env-file=.env.team ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node --env-file=.env.development ./node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main",
    "db:migrate": "npm run build && node --env-file=.env.development ./node_modules/typeorm/cli.js migration:run -d ./dist/database/data-source.js",
    "db:migrate:team": "npm run build && node --env-file=.env.team ./node_modules/typeorm/cli.js migration:run -d ./dist/database/data-source.js",
    "db:seed": "npm run build && node --env-file=.env.development ./dist/database/seed.js",
    "db:seed:team": "npm run build && node --env-file=.env.team ./dist/database/seed.js",
    "app:up": "docker compose --env-file .env.development -p where-are-my-tickets-dev up -d --wait postgres && npm run db:migrate && npm run db:seed",
    "app:down": "docker compose --env-file .env.development -p where-are-my-tickets-dev stop postgres",
    "ensure:dependencies": "node ./scripts/ensure-dependencies.mjs",
    "app:up:team": "npm run ensure:dependencies && docker compose --env-file .env.team -p where-are-my-tickets-team up -d --wait postgres && npm run db:migrate:team && npm run db:seed:team && docker compose --env-file .env.team -p where-are-my-tickets-team up --build -d",
    "app:down:team": "docker compose --env-file .env.team -p where-are-my-tickets-team stop",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "bcrypt": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.0.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
